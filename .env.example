# Copier en .env puis compléter :  cp .env.example .env   (.env est ignoré par git)

# OpenAgenda — clé publique gratuite (compte sur openagenda.com)
OA_KEY=
# HuggingFace — jeton en écriture pour la publication du dataset
HF_TOKEN=

# PostgreSQL (docker compose up -d)
PG_DSN=postgresql://etl:etl@localhost:5432/metropole

# Mode secours (API locale : python secours/serveur_api_local.py) — décommenter si une API est indisponible
# OA_API=http://localhost:8765/openagenda/v2
# PORTAIL_API=http://localhost:8765/ods/api/explore/v2.1/catalog/datasets
